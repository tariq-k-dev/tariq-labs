{
  "name": "@labs/querylens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "In-browser analytics over partitioned Parquet in object storage, with a per-query latency and bytes-read budget.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "precompute": "tsx scripts/precompute.ts",
    "verify:live": "tsx scripts/verify-live.ts"
  },
  "dependencies": {
    "@labs/data-core": "workspace:*",
    "hyparquet": "1.31.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  }
}
