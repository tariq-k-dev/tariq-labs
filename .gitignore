# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Measurement output from a local run (the recorded numbers live in README/docs)
apps/*/out/

# Python
__pycache__/
*.py[cod]
.venv/
# uv.lock is deliberately NOT ignored — CI must install the locked set.

# Local data artifacts — regenerated by pipelines/bts/generate_sample.py or bts/fetch.py
# Real Parquet lives in R2; nothing derived should be committed.
data/
*.parquet
# Downloaded source archives (30 MB per month of zips, re-fetched on demand)
.cache/

# Spike measurements are recorded in docs/, not committed as raw output
spikes/**/out/

# Env / secrets
.env
.env.*
!.env.example
.dev.vars
*api_key*
*secret*
wrangler/.wrangler/
.wrangler/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local build artefacts from a spike run
spikes/**/build-report.txt
